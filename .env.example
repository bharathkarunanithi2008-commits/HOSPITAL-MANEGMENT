# ==========================================
# HOSPITAL MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# ==========================================
# Copy this file to .env and configure values before running services.
# NEVER commit the real .env file into source control.

# --- DJANGO BACKEND CONFIGURATION ---
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- DATABASE CONFIGURATION (PostgreSQL) ---
DB_NAME=hospital_db
DB_USER=hospital_user
DB_PASSWORD=hospital_secure_password
DB_HOST=localhost
DB_PORT=5432

# --- JWT AUTHENTICATION CONFIGURATION ---
JWT_SECRET_KEY=jwt-secret-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS & FRONTEND ORIGIN ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- FRONTEND CLIENT CONFIGURATION ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_TITLE=Hospital Management System

# --- GEMINI AI API (Optional) ---
# GEMINI_API_KEY=MY_GEMINI_API_KEY

